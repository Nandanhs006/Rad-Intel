# Rad-Intel Backend Configuration

# Gemini API Key (optional for testing with mock report fallback; required for live LLM reports)
GEMINI_API_KEY=

# Hardware Device: "auto", "cpu", or "cuda"
DEVICE=auto

# Default Model Architecture: "hybrid", "densenet121", "swin_t", "hybrid_no_cbam", "resnet50"
DEFAULT_MODEL=hybrid

# Model Weights Path (optional: leaving empty uses initialized backbone weights for development)
MODEL_WEIGHTS_PATH=

# Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Storage
DATABASE_URL=sqlite+aiosqlite:///./rad_intel.db
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# Clinician review workspace
# ---------------------------------------------------------------------------
# These are read from the process environment, not from the Settings object,
# so that no endpoint or log can return them.

# Signs sessions and encrypts stored phone numbers. Set this in any real
# deployment: without it a key is generated into .radintel_key instead, which
# works but is one more file to keep and back up.
#   python -c "import secrets; print(secrets.token_hex(32))"
RAD_INTEL_SECRET_KEY=

# Set to 1 once the site is served over HTTPS, so the session cookie is never
# sent in the clear.
RAD_INTEL_COOKIE_SECURE=

# --- one-time sign-in codes ---
# Codes go by SMS when a provider is set, otherwise by email, otherwise (only
# with the echo below) to this server's own log. They are NEVER sent over
# WhatsApp: a phone number here is for texting a code and for the
# administrator to reach that clinician personally.
#
# Pin the channel when both SMS and email are available. "sms" or "email".
RAD_INTEL_OTP_CHANNEL=

# India: Twilio will not carry domestic A2P SMS without DLT registration
# under TRAI's rules, so use Fast2SMS. The key is in its Dev API section.
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q

# Outside India: Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# LOCAL TESTING ONLY. With nothing else configured, writes sign-in codes to
# the server's own log so the workspace can be demonstrated on a laptop.
# Never set this on a host anybody else can reach.
RAD_INTEL_OTP_ECHO=

# --- access-request notifications ---
# Where "I am a clinician and would like access" is emailed. Requests are
# recorded and shown in the administrator console whether or not this works.
RAD_INTEL_ADMIN_EMAIL=poorabng@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set to 1 only when the service sits behind a reverse proxy you control, so
# X-Forwarded-For is trusted for rate limiting. Any client can set that
# header, so trusting it elsewhere makes the limits meaningless.
RAD_INTEL_TRUSTED_PROXY=
