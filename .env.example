# Rad-Intel Backend Configuration

# Gemini API Key (optional for testing with mock report fallback; required for live LLM reports)
GEMINI_API_KEY=

# Hardware Device: "auto", "cpu", or "cuda"
DEVICE=auto

# Default Model Architecture: "hybrid", "densenet121", "swin_t", "hybrid_no_cbam", "resnet50"
DEFAULT_MODEL=hybrid

# Model Weights Path (optional: leaving empty uses initialized backbone weights for development)
MODEL_WEIGHTS_PATH=

# Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Storage
DATABASE_URL=sqlite+aiosqlite:///./rad_intel.db
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# Clinician review workspace
# ---------------------------------------------------------------------------
# These are read from the process environment, not from the Settings object,
# so that no endpoint or log can return them.

# Signs sessions and encrypts stored phone numbers. Set this in any real
# deployment: without it a key is generated into .radintel_key instead, which
# works but is one more file to keep and back up.
#   python -c "import secrets; print(secrets.token_hex(32))"
RAD_INTEL_SECRET_KEY=

# Set to 1 once the site is served over HTTPS, so the session cookie is never
# sent in the clear.
RAD_INTEL_COOKIE_SECURE=

# --- one-time sign-in codes and notifications ---
# One channel: email. Codes go to each account's own address and access
# requests to the administrator, through the same mail server. There is no
# SMS -- India's DLT rules make it paperwork, and it bought nothing email
# does not already do.
RAD_INTEL_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set to "log" to write codes to this server's own terminal and send them
# nowhere: for demonstrating the workspace, and for getting back in when mail
# has broken. Leave blank for normal use.
RAD_INTEL_OTP_CHANNEL=

# As above, but only when nothing else is configured. LOCAL TESTING ONLY.
RAD_INTEL_OTP_ECHO=

# Set to 1 only when the service sits behind a reverse proxy you control, so
# X-Forwarded-For is trusted for rate limiting. Any client can set that
# header, so trusting it elsewhere makes the limits meaningless.
RAD_INTEL_TRUSTED_PROXY=

# Where reviewed radiographs and export manifests are kept. Leave blank to
# use ./feedback_store. Set it when hosting: most small hosts wipe a
# container's filesystem on every redeploy, so this has to point at a volume
# that survives -- a mounted disk, or a cloud folder mounted into the
# filesystem with something like rclone.
RAD_INTEL_FEEDBACK_DIR=

# Publish the interactive API documentation at /docs, /redoc and
# /openapi.json. It is a complete directory of the service, administrator
# routes included: useful while building, of no use to a visitor. Leave
# blank in anything anybody else can reach.
RAD_INTEL_ENABLE_DOCS=

# Comma-separated origins allowed to make credentialed cross-origin requests.
# Leave blank unless a separate front end is hosted elsewhere; the interface
# here is served from this same origin and needs none. There is no wildcard:
# a credentialed wildcard lets any website call this API.
RAD_INTEL_CORS_ORIGINS=
