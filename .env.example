# Rad-Intel Backend Configuration

# Gemini API Key (optional for testing with mock report fallback; required for live LLM reports)
GEMINI_API_KEY=

# Hardware Device: "auto", "cpu", or "cuda"
DEVICE=auto

# Default Model Architecture: "hybrid", "densenet121", "swin_t", "hybrid_no_cbam", "resnet50"
DEFAULT_MODEL=hybrid

# Model Weights Path (optional: leaving empty uses initialized backbone weights for development)
MODEL_WEIGHTS_PATH=

# Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Storage
DATABASE_URL=sqlite+aiosqlite:///./rad_intel.db
UPLOAD_DIR=./uploads
