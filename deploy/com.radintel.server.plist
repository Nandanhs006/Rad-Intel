<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps Rad-Intel running on this Mac.

  Install:
    cp deploy/com.radintel.server.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.radintel.server.plist

  Stop it:   launchctl unload -w ~/Library/LaunchAgents/com.radintel.server.plist
  Watch it:  tail -f ~/Library/Logs/rad-intel.log

  Edit the two paths below if your username or project folder differ.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.radintel.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/Documents/GitHub/Rad-Intel/deploy/run-rad-intel.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/Documents/GitHub/Rad-Intel</string>

  <!-- Start at login, and start again if it ever stops. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Do not restart faster than this, so a crash loop does not spin. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/rad-intel.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/rad-intel.log</string>
</dict>
</plist>
